# Browser-safe Supabase project configuration (placeholders only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key
VITE_API_BASE_URL=http://localhost:8000

# Server-only configuration (never expose through VITE_* variables)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require