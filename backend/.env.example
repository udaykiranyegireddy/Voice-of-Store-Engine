# Server-only Supabase settings. Copy to backend/.env for local development.
# Use the project's publishable key plus its server-only secret key.
# Legacy SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY names remain supported.
# Never put SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY in a VITE_* variable or frontend file.
SUPABASE_URL=https://nxtpqjybosaibjncmbvf.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
# Optional verified denominator file for R5 weekly briefs.
# Expected columns: store_id,week_index,total_transactions
# VOS_R5_TRANSACTIONS_CSV=C:\\path\\to\\verified_store_weekly_transactions.csv
